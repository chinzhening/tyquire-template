{
    "name": "svelte-blog",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.17.0"
        }
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p plugins/tyquire",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "pnpm prettier --check . && pnpm eslint .",
        "format": "pnpm prettier --write ."
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.4",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/load-config": "^0.2.2",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@types/node": "^22",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.0",
        "globals": "^17.4.0",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.5",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vite": "^8.0.12"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "cheerio": "^1.2.0",
        "domhandler": "^6.0.1",
        "shiki": "^4.0.2",
        "tailwindcss": "^4.3.0"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
